# PetClinic REST API
API_BASE_URL=http://localhost:9966/petclinic

# Database: postgres или mysql. Выбирает и драйвер тестов, и стенд Docker Compose
DB_ENGINE=postgres
COMPOSE_PROFILES=${DB_ENGINE}
DB_HOST=localhost
# 5432 для postgres, 3306 для mysql
DB_PORT=5432
DB_NAME=petclinic
DB_USER=petclinic
DB_PASSWORD=petclinic